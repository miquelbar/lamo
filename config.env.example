# ==============================================================================
# Global Baseline Configuration & Defaults
# ==============================================================================
# Note: For multi-server setups, individual cattle nodes are registered in
# nodes.json (see nodes.json.example). These values serve as the default baseline
# when adding new servers or initializing a single-node setup.

# Default target server IP address (optional if nodes.json defines nodes)
SERVER_IP="123.45.67.89"

# Default initial bootstrap credentials (root on standard port 22 before hardening)
BOOTSTRAP_USER="root"
BOOTSTRAP_PORT="22"

# Default hardened access configuration
ADMIN_USER="admin"
SSH_PORT="2245"
SERVER_HOSTNAME="myserver"

# Default container engine runtime (docker or podman, default: docker)
CONTAINER_RUNTIME="docker"

# Local public SSH key to deploy for the admin user
LOCAL_SSH_PUBKEY="${HOME}/.ssh/id_ed25519.pub"

# Swap configuration (capacity in Gigabytes, default: 2)
SWAP_SIZE_GB="2"

# Logging and audit retention configuration
# Retention in days for user activity logs, sudo logs, auth logs, and systemd journal
USER_AUDIT_RETENTION_DAYS="7"

# Systemd journal disk capacity cap in megabytes
JOURNALD_MAX_USE_MB="150"

# Docker container log rotation boundaries (json-file driver)
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILES="3"

