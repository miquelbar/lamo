def cmd_list_nodes(base_cfg):
    """List all configured cattle servers, connectivity status, and app counts."""
    reg = get_nodes_registry(base_cfg)
    default_node = reg.get("default")
    nodes = reg.get("nodes", {})

    headers = ["NODE", "HOST:PORT", "USER", "RUNTIME", "STATUS", "APPS", "ROLE"]
    table_rows = []

    for name, info in nodes.items():
        is_default = (name == default_node)
        display_name = f"{name} *" if is_default else name
        host_str = f"{info['host']}:{info.get('port', 2245)}"
        user_str = info.get("user", "admin")
        runtime_str = info.get("container_runtime", "docker")

        # Probe status
        node_cfg = dict(base_cfg)
        node_cfg["NODE_NAME"] = name
        node_cfg["SERVER_IP"] = info["host"]
        node_cfg["SSH_PORT"] = str(info.get("port", 2245))
        node_cfg["ADMIN_USER"] = user_str

        status_str = f"{RED}OFFLINE{RESET}"
        apps_count = "-"
        try:
            out = run_ssh(node_cfg, "echo 'PONG'", capture=True)
            if "PONG" in out:
                status_str = f"{GREEN}ONLINE{RESET}"
                apps_out = run_ssh(node_cfg, "sudo -u bover bover list 2>/dev/null", capture=True)
                if "No services configured" in apps_out:
                    apps_count = "0 apps"
                elif apps_out:
                    lines = [l for l in apps_out.splitlines() if l.strip() and not l.startswith("=")]
                    apps_count = f"{max(0, len(lines) - 2)} apps"
                else:
                    apps_count = "0 apps"
        except Exception:
            pass

        role_str = "Default Node" if is_default else info.get("notes", "Cattle Node")
        table_rows.append([display_name, host_str, user_str, runtime_str, status_str, apps_count, role_str])

    hdr_line, sep_line, row_lines = format_table(headers, table_rows)
    w = max(len(hdr_line), 74)
    print(f"\n{BOLD}{'=' * w}{RESET}")
    print(f" {GOLD}ESTATE SERVERS & CATTLE NODES REGISTRY{RESET} :: L'Amo Fleet")
    print(f"{BOLD}{'=' * w}{RESET}")
    print(hdr_line)
    print(sep_line)
    for r in row_lines:
        print(r)
    print(f"{'-' * w}")
    print(f"{DIM}* Default active node. Switch with 'lamo node use <name>' or target with '-n <name>'.{RESET}\n")


def cmd_list_apps_multi(base_cfg, target_node_name=None):
    """List applications across cattle servers, displaying the node/server column."""
    reg = get_nodes_registry(base_cfg)
    default_node = reg.get("default")
    nodes = reg.get("nodes", {})

    target_node_configs = {}
    if target_node_name:
        node_cfg, _ = resolve_active_node(base_cfg, target_node_name)
        target_node_configs[node_cfg.get("NODE_NAME", target_node_name)] = node_cfg
        nodes = {target_node_name: node_cfg}
    else:
        for node_name in nodes:
            try:
                cfg, _ = resolve_active_node(base_cfg, node_name)
                target_node_configs[node_name] = cfg
            except Exception:
                continue

    headers = ["NODE", "APP", "DOMAIN", "SLOT", "CONTAINER", "STATUS"]
    table_rows = []

    for node_name, node_cfg in target_node_configs.items():
        is_default = (node_name == default_node)
        display_node = f"{node_name} *" if is_default else node_name

        try:
            out = run_ssh(node_cfg, "sudo -u bover bover list", capture=True)
            if not out or "No services configured" in out:
                continue

            for line in out.strip().splitlines():
                parts = line.split()
                if not parts or parts[0] in ("SERVICE", "APP") or parts[0].startswith("=") or parts[0].startswith("-"):
                    continue
                app_name = parts[0]
                domain = parts[1] if len(parts) > 1 else "-"
                slot = parts[2] if len(parts) > 2 else "-"
                container = "-"
                status = "-"
                for i, p in enumerate(parts):
                    if p.startswith(f"{app_name}-") and ("blue" in p or "green" in p):
                        container = p
                        status = " ".join(parts[i+1:])
                        break
                if container == "-":
                    container = parts[4] if len(parts) > 4 else "-"
                    status = " ".join(parts[5:]) if len(parts) > 5 else "running"

                table_rows.append([display_node, app_name, domain, slot, container, status])
        except Exception:
            table_rows.append([display_node, "-", "-", "-", "-", f"{RED}[unreachable]{RESET}"])

    if not table_rows:
        hdr_line, sep_line, _ = format_table(headers, [])
        w = max(len(hdr_line), 74)
        print(f"\n{BOLD}{'=' * w}{RESET}")
        print(f" {GOLD}MANAGED APPLICATIONS & DEPLOYMENT INVENTORY{RESET} :: L'Amo Fleet")
        print(f"{BOLD}{'=' * w}{RESET}")
        print(hdr_line)
        print(sep_line)
        print(" No active applications found.")
        print(f"{'-' * w}\n")
        return

    hdr_line, sep_line, row_lines = format_table(headers, table_rows)
    w = max(len(hdr_line), 74)
    print(f"\n{BOLD}{'=' * w}{RESET}")
    print(f" {GOLD}MANAGED APPLICATIONS & DEPLOYMENT INVENTORY{RESET} :: L'Amo Fleet")
    print(f"{BOLD}{'=' * w}{RESET}")
    print(hdr_line)
    print(sep_line)
    for r in row_lines:
        print(r)
    print(f"{'-' * w}")
    if not target_node_name and len(nodes) > 1:
        print(f"{DIM}* Default active node. Filter specific node with '-n <name>' or 'lamo node apps <name>'.{RESET}\n")
    else:
        print("")


def cmd_node_action(base_cfg, args):
    """Handle node management subcommands."""
    reg = get_nodes_registry(base_cfg)
    action = args.node_action

    if action in (None, "list"):
        cmd_list_nodes(base_cfg)
    elif action == "status":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_name", None) or getattr(args, "target_node", None))
        cmd_status(cfg)
    elif action == "stats":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_name", None) or getattr(args, "target_node", None))
        sys.exit(cmd_node_stats(cfg))
    elif action == "apps":
        target = getattr(args, "target_name", None) or getattr(args, "target_node", None)
        cmd_list_apps_multi(base_cfg, target_node_name=target)
    elif action == "ping":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_name", None) or getattr(args, "target_node", None))
        sys.exit(cmd_ping(cfg))
    elif action == "ssh":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
        cmd = getattr(args, "command", None)
        if cmd:
            run_ssh(cfg, " ".join(cmd))
        else:
            run_ssh(cfg, "", interactive=True)
    elif action == "caddy":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
        caddy_act = getattr(args, "action", "status")
        if caddy_act == "reload":
            run_ssh(cfg, "sudo -u bover bover caddy reload")
        elif caddy_act == "logs":
            run_ssh(cfg, "sudo -u bover bover caddy logs", interactive=True)
        elif caddy_act == "status":
            run_ssh(cfg, "sudo -u bover bover caddy status")
        elif caddy_act == "stats":
            run_ssh(cfg, "sudo -u bover bover caddy stats")
    elif action == "setup":
        has_nodes = bool(reg.get("nodes")) and any(n.get("host") for n in reg.get("nodes", {}).values())
        if getattr(args, "init", False) or getattr(args, "host", None) or (not has_nodes and not base_cfg.get("SERVER_IP")):
            cfg = bootstrap_vps_wizard(base_cfg, args)
        else:
            target = getattr(args, "target_name", None) or getattr(args, "target_node", None)
            if target and re.match(r"^\d{1,3}(\.\d{1,3}){3}$", target):
                cfg = bootstrap_vps_wizard(base_cfg, args)
            else:
                cfg, _ = resolve_active_node(base_cfg, target)
        cmd_setup(cfg, force=getattr(args, "force", False))
    elif action == "apply":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
        cmd_apply(cfg, force=getattr(args, "force", False))
    elif action == "step":
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
        cmd_step(cfg, args.name, force=getattr(args, "force", False))
    elif action in ("update", "update-node"):
        cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
        cmd_update_node(cfg)
    elif action == "use":
        target = args.target_name
        if target not in reg.get("nodes", {}):
            print(f"{RED}ERROR: Node '{target}' not found in registry.{RESET}")
            sys.exit(1)
        reg["default"] = target
        save_nodes_registry(reg)
        print(f"{GREEN}✓ Active default node switched to '{target}'.{RESET}")
    elif action == "add":
        name = getattr(args, "target_name", None)
        host = getattr(args, "host", None)

        # Interactive wizard if positional arguments are omitted
        if not name or not host:
            print(f"\n{BOLD}=== Register New Cattle Server Node ==={RESET}\n")
            if not name:
                name = input("Node identifier (e.g. worker-2): ").strip()
                if not name:
                    print(f"{RED}ERROR: Node name cannot be empty.{RESET}")
                    sys.exit(1)
            if not host:
                host = input("Server IP address or domain: ").strip()
                if not host:
                    print(f"{RED}ERROR: Server IP cannot be empty.{RESET}")
                    sys.exit(1)

        user = getattr(args, "user", None)
        if not isinstance(user, str):
            user = base_cfg.get("ADMIN_USER", "admin")

        port = getattr(args, "port", None)
        try:
            port = int(port)
        except (TypeError, ValueError):
            port = int(base_cfg.get("SSH_PORT", 2245))

        bootstrap_user = getattr(args, "bootstrap_user", None)
        if not isinstance(bootstrap_user, str):
            bootstrap_user = base_cfg.get("BOOTSTRAP_USER", "root")

        bootstrap_port = getattr(args, "bootstrap_port", None)
        try:
            bootstrap_port = int(bootstrap_port)
        except (TypeError, ValueError):
            bootstrap_port = int(base_cfg.get("BOOTSTRAP_PORT", 22))

        notes = getattr(args, "notes", None)
        if not isinstance(notes, str):
            notes = "Cattle Node"

        runtime = getattr(args, "runtime", None)
        if not isinstance(runtime, str) or not runtime:
            if not getattr(args, "target_name", None) or not getattr(args, "host", None):
                runtime = input("Container runtime [docker/podman] (default: docker): ").strip().lower() or "docker"
            else:
                runtime = base_cfg.get("CONTAINER_RUNTIME", "docker")
        runtime = str(runtime).lower()
        if runtime not in ("docker", "podman"):
            runtime = "docker"

        reg["nodes"][name] = {
            "name": name,
            "host": host,
            "port": int(port),
            "user": user,
            "bootstrap_user": bootstrap_user,
            "bootstrap_port": int(bootstrap_port),
            "hostname": name,
            "container_runtime": runtime,
            "notes": notes,
        }

        if getattr(args, "audit_retention_days", None) is not None:
            reg["nodes"][name]["audit_retention_days"] = int(args.audit_retention_days)
        if getattr(args, "journald_max_use_mb", None) is not None:
            reg["nodes"][name]["journald_max_use_mb"] = int(args.journald_max_use_mb)
        if getattr(args, "docker_log_max_size", None) is not None:
            reg["nodes"][name]["docker_log_max_size"] = str(args.docker_log_max_size)
        if getattr(args, "docker_log_max_files", None) is not None:
            reg["nodes"][name]["docker_log_max_files"] = str(args.docker_log_max_files)

        save_nodes_registry(reg)
        print(f"{GREEN}✓ Node '{name}' ({host}:{port}) added to registry.{RESET}")
        print(f"  Bootstrap: {bootstrap_user}@{host}:{bootstrap_port}")
        print(f"  Hardened:  {user}@{host}:{port}")
        print(f"  Runtime:   {runtime}")
        print(f"\n💡 Run '{CYAN}./lamo -n {name} ping{RESET}' to test connectivity, then '{CYAN}./lamo -n {name} setup{RESET}' to provision.")
    elif action == "remove":
        name = args.target_name
        if name not in reg.get("nodes", {}):
            print(f"{RED}ERROR: Node '{name}' does not exist.{RESET}")
            sys.exit(1)
        if len(reg["nodes"]) <= 1:
            print(f"{RED}ERROR: Cannot remove the only remaining node.{RESET}")
            sys.exit(1)
        del reg["nodes"][name]
        if reg.get("default") == name:
            reg["default"] = next(iter(reg["nodes"].keys()))
        save_nodes_registry(reg)
        print(f"{GREEN}✓ Node '{name}' removed from registry.{RESET}")


def cmd_app_action(base_cfg, args):
    """Handle application lifecycle and observability subcommands."""
    action = getattr(args, "app_action", None)
    if action in (None, "list"):
        if getattr(args, "app", None):
            cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
            app_safe = validate_app_name(args.app)
            run_ssh(cfg, f"sudo -u bover bover status {shlex.quote(app_safe)}")
        elif getattr(args, "target_node", None):
            cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
            run_ssh(cfg, "sudo -u bover bover list")
        else:
            cmd_list_apps_multi(base_cfg, None)
        return

    cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))

    if action == "status":
        app_safe = validate_app_name(args.app)
        run_ssh(cfg, f"sudo -u bover bover status {shlex.quote(app_safe)}")
    elif action == "stats":
        app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
        run_ssh(cfg, f"sudo -u bover bover stats {app_arg}".strip())
    elif action == "deploy":
        name = validate_app_name(args.name)
        no_pull = "--no-pull" if getattr(args, "no_pull", False) else ""
        run_ssh(cfg, f"sudo -u bover bover deploy {shlex.quote(name)} {no_pull}".strip())
    elif action == "rollback":
        name = validate_app_name(args.name)
        run_ssh(cfg, f"sudo -u bover bover rollback {shlex.quote(name)}")
    elif action == "restart":
        name = validate_app_name(args.name)
        run_ssh(cfg, f"sudo -u bover bover restart {shlex.quote(name)}")
    elif action == "logs":
        name = validate_app_name(args.name)
        follow = "-f" if getattr(args, "follow", False) else ""
        lines = int(getattr(args, "lines", 100))
        run_ssh(cfg, f"sudo -u bover bover logs {shlex.quote(name)} {follow} -n {lines}".strip(), interactive=getattr(args, "follow", False))
    elif action == "config":
        name = validate_app_name(getattr(args, "name", None) or getattr(args, "app", None))
        json_f = "--json" if getattr(args, "json", False) else ""
        sec_f = "--show-secrets" if getattr(args, "show_secrets", False) else ""
        run_ssh(cfg, f"sudo -u bover bover config {shlex.quote(name)} {json_f} {sec_f}".strip())
    elif action == "env":
        app = validate_app_name(args.app)
        cmd_parts = [f"sudo -u bover bover env {shlex.quote(app)}"]
        if getattr(args, "set", None):
            for s in args.set:
                cmd_parts.append(f"--set {shlex.quote(s)}")
        if getattr(args, "unset", None):
            for u in args.unset:
                cmd_parts.append(f"--unset {shlex.quote(u)}")
        run_ssh(cfg, " ".join(cmd_parts))
    elif action == "disk":
        app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
        run_ssh(cfg, f"sudo -u bover bover disk {app_arg}".strip())
    elif action == "visits":
        app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
        run_ssh(cfg, f"sudo -u bover bover visits {app_arg}".strip())
    elif action == "history":
        app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
        run_ssh(cfg, f"sudo -u bover bover history {app_arg}".strip())
    elif action == "prune":
        app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
        run_ssh(cfg, f"sudo -u bover bover prune {app_arg}".strip())
    elif action == "autodeploy":
        run_ssh(cfg, "sudo -u bover bover autodeploy")
    elif action == "add":
        if args.repo and (args.domain or args.port):
            cmd_parts = [f"sudo -u bover bover add {args.repo}"]
            if getattr(args, "domain", None):
                cmd_parts.append(f"--domain {args.domain}")
            if getattr(args, "port", None):
                cmd_parts.append(f"--port {args.port}")
            if getattr(args, "branch", None):
                cmd_parts.append(f"--branch {args.branch}")
            if getattr(args, "cpu", None):
                cmd_parts.append(f"--cpu {args.cpu}")
            if getattr(args, "memory", None):
                cmd_parts.append(f"--memory {shlex.quote(args.memory)}")
            if getattr(args, "type", None) and args.type != "auto":
                cmd_parts.append(f"--type {args.type}")
            if getattr(args, "redirect", None):
                cmd_parts.append(f"--redirect {shlex.quote(args.redirect)}")
            if getattr(args, "data_dir", None):
                cmd_parts.append(f"--data-dir {shlex.quote(args.data_dir)}")
            run_ssh(cfg, " ".join(cmd_parts))
        elif args.repo:
            run_ssh(cfg, f"sudo -u bover bover add {args.repo}", interactive=True)
        else:
            run_ssh(cfg, "sudo -u bover bover add", interactive=True)
    elif action in ("remove", "rm", "destroy"):
        name = validate_app_name(args.name)
        keep_data = "--keep-data" if getattr(args, "keep_data", False) else ""
        force = "--force" if getattr(args, "force", False) else ""
        run_ssh(cfg, f"sudo -u bover bover remove {shlex.quote(name)} {keep_data} {force}".strip(), interactive=not getattr(args, "force", False))
    elif action == "backup":
        action_or_app = getattr(args, "action_or_app", "all")
        app_names = getattr(args, "app_names", []) or []
        if action_or_app == "config":
            run_ssh(cfg, "sudo -u bover bover backup config", interactive=True)
        elif action_or_app in ("all", "run-all"):
            run_ssh(cfg, "sudo -u bover bover backup all")
        elif action_or_app == "run":
            if not app_names:
                print("Error: Application name required for 'backup run <app...>'")
                sys.exit(1)
            safe_apps = [shlex.quote(validate_app_name(a)) for a in app_names]
            run_ssh(cfg, f"sudo -u bover bover backup run {' '.join(safe_apps)}")
        else:
            all_apps = [action_or_app] + app_names
            safe_apps = [shlex.quote(validate_app_name(a)) for a in all_apps]
            run_ssh(cfg, f"sudo -u bover bover backup run {' '.join(safe_apps)}")
    elif action in ("cron", "crons"):
        c_act = getattr(args, "cron_action", None)
        if c_act in (None, "list", "ls"):
            app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
            run_ssh(cfg, f"sudo -u bover bover cron list {app_arg}".strip())
        elif c_act == "add":
            app_safe = shlex.quote(validate_app_name(args.app))
            job_safe = shlex.quote(validate_cron_id(args.job_id))
            sched_safe = shlex.quote(args.schedule)
            cmd_safe = shlex.quote(args.job_command)
            mode_val = shlex.quote(getattr(args, "mode", "exec") or "exec")
            timeout_val = int(getattr(args, "timeout", 3600) or 3600)
            notify_val = shlex.quote(getattr(args, "notify", "on_failure") or "on_failure")
            parts = [
                f"sudo -u bover bover cron add {app_safe} {job_safe} {sched_safe} {cmd_safe}",
                f"--mode {mode_val}",
                f"--timeout {timeout_val}",
                f"--notify {notify_val}",
            ]
            if getattr(args, "description", None):
                parts.append(f"--description {shlex.quote(args.description)}")
            if getattr(args, "overlap", False):
                parts.append("--overlap")
            run_ssh(cfg, " ".join(parts))
        elif c_act in ("remove", "rm", "delete"):
            app_safe = shlex.quote(validate_app_name(args.app))
            job_safe = shlex.quote(validate_cron_id(args.job_id))
            run_ssh(cfg, f"sudo -u bover bover cron remove {app_safe} {job_safe}")
        elif c_act == "enable":
            app_safe = shlex.quote(validate_app_name(args.app))
            job_safe = shlex.quote(validate_cron_id(args.job_id))
            run_ssh(cfg, f"sudo -u bover bover cron enable {app_safe} {job_safe}")
        elif c_act == "disable":
            app_safe = shlex.quote(validate_app_name(args.app))
            job_safe = shlex.quote(validate_cron_id(args.job_id))
            run_ssh(cfg, f"sudo -u bover bover cron disable {app_safe} {job_safe}")
        elif c_act == "run":
            app_safe = shlex.quote(validate_app_name(args.app))
            job_safe = shlex.quote(validate_cron_id(args.job_id))
            run_ssh(cfg, f"sudo -u bover bover cron run {app_safe} {job_safe}")
        elif c_act in ("history", "logs", "runs"):
            app_arg = shlex.quote(validate_app_name(args.app)) if getattr(args, "app", None) else ""
            job_opt = f"--job {shlex.quote(validate_cron_id(args.job_id))}" if getattr(args, "job_id", None) else ""
            limit_val = int(getattr(args, "limit", 25) or 25)
            run_ssh(cfg, f"sudo -u bover bover cron history {app_arg} {job_opt} -n {limit_val}".strip())
        elif c_act in ("show", "output", "inspect"):
            run_id = int(args.run_id)
            run_ssh(cfg, f"sudo -u bover bover cron show {run_id}")


def cmd_telegram(base_cfg, args):
    """Handle Telegram notification testing and custom dispatch."""
    cfg, _ = resolve_active_node(base_cfg, getattr(args, "target_node", None))
    action = getattr(args, "action", None)
    if getattr(args, "token", None) and getattr(args, "chat_id", None):
        run_ssh(cfg, f"sudo -u bover bover telegram --token {shlex.quote(args.token)} --chat-id {shlex.quote(args.chat_id)} --test")
    elif getattr(args, "send", None) or action == "send":
        msg = getattr(args, "send", None) or getattr(args, "message", None) or "Test alert from lamo"
        run_ssh(cfg, f"sudo -u bover bover telegram --send {shlex.quote(msg)}")
    elif getattr(args, "test", False) or action == "test":
        run_ssh(cfg, "sudo -u bover bover telegram --test")
    else:
        run_ssh(cfg, "sudo -u bover bover telegram", interactive=True)


