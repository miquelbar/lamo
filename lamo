def cmd_update_node(cfg):
    """Upload latest bover CLI and helper to the targeted cattle node."""
    print(f"==> Uploading latest 'bover' CLI and helper to node {GOLD}{cfg.get('NODE_NAME')}{RESET} ({cfg['SERVER_IP']})...")
    mux_opts = get_ssh_mux_opts(cfg)
    scp_cmd = [
        "scp",
        *mux_opts,
        "-P", str(cfg["SSH_PORT"]),
        str(BASE_DIR / "scripts" / "bover-cli.py"),
        f"{cfg['ADMIN_USER']}@{cfg['SERVER_IP']}:/tmp/bover-cli.py",
    ]
    subprocess.run(scp_cmd, check=True)

    wrapper_cmd = (
        "sudo mkdir -p /usr/local/lib/bover && "
        "sudo cp /tmp/bover-cli.py /usr/local/lib/bover/bover_cli.py && "
        "sudo python3 -m compileall -f -q /usr/local/lib/bover && "
        "sudo chmod -R 755 /usr/local/lib/bover && "
        "printf '#!/usr/bin/env python3\\nimport sys\\nsys.path.insert(0, \"/usr/local/lib/bover\")\\nfrom bover_cli import main\\nif __name__ == \"__main__\":\\n    main()\\n' | sudo tee /usr/local/bin/bover >/dev/null && "
        "sudo chmod 755 /usr/local/bin/bover && "
    )

    helper_path = BASE_DIR / "scripts" / "bover-helper.sh"
    if helper_path.exists():
        scp_helper = [
            "scp",
            *mux_opts,
            "-P", str(cfg["SSH_PORT"]),
            str(helper_path),
            f"{cfg['ADMIN_USER']}@{cfg['SERVER_IP']}:/tmp/bover-helper.sh",
        ]
        subprocess.run(scp_helper, check=True)
        remote_install = (
            wrapper_cmd +
            "sudo cp /tmp/bover-helper.sh /usr/local/bin/bover-helper && "
            "sudo chmod 755 /usr/local/bin/bover-helper && "
            "sudo chown root:root /usr/local/bin/bover-helper && "
            "sudo /usr/local/bin/bover systemd >/dev/null 2>&1 || true && "
            "sudo rm -f /usr/local/bin/pages /usr/local/bin/lamo /usr/local/bin/appctl && "
            "rm -f /tmp/bover-cli.py /tmp/bover-helper.sh"
        )
    else:
        remote_install = (
            wrapper_cmd +
            "sudo /usr/local/bin/bover systemd >/dev/null 2>&1 || true && "
            "sudo rm -f /usr/local/bin/pages /usr/local/bin/lamo /usr/local/bin/appctl && "
            "rm -f /tmp/bover-cli.py"
        )
    run_ssh(cfg, remote_install)
    print(f"{GREEN}✓ 'bover' CLI and helper successfully updated on node '{cfg.get('NODE_NAME')}'.{RESET}")


