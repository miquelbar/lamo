"""
Lamo (L'Amo) - Local Multi-Server & Application Orchestrator
Inspired by the Mallorcan 'L'Amo' (the estate overseer and administrator).
Orchestrates remote cattle servers running 'bover' (Es Bover) runtime worker daemon.
Zero-friction multi-server management without requiring raw Make targets.
"""

import sys
import os
import re
import json
import shlex
import argparse
import subprocess
import shutil
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
CONFIG_PATH = None
NODES_CONFIG_PATH = None
SSH_MUX_DIR = Path(f"/tmp/ssh-mux-{os.getuid()}")
SSH_MUX_DIR.mkdir(parents=True, exist_ok=True)

# ANSI Colors
GOLD = "\033[38;5;214m"
CYAN = "\033[38;5;75m"
GREEN = "\033[38;5;78m"
RED = "\033[38;5;203m"
DIM = "\033[2m"
BOLD = "\033[1m"
RESET = "\033[0m"

ANSI_REGEX = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")


def visible_len(s):
    """Return visible character length of string excluding ANSI escape sequences."""
    return len(ANSI_REGEX.sub("", str(s)))


def format_table(headers, rows, max_width=None):
    """
    Format rows into a clean, aligned table adapting dynamically to terminal width.
    Automatically clips cell content if total width exceeds max_width or terminal columns.
    """
    if max_width is None:
        try:
            term_cols = shutil.get_terminal_size((80, 24)).columns
            max_width = min(max(term_cols, 72), 100)
        except Exception:
            max_width = 80

    num_cols = len(headers)
    widths = [visible_len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            if i < num_cols:
                widths[i] = max(widths[i], visible_len(val))

    total = sum(widths) + (num_cols - 1) * 2
    if total > max_width:
        excess = total - max_width
        widest_idx = widths.index(max(widths))
        widths[widest_idx] = max(8, widths[widest_idx] - excess)

    header_cells = []
    for i, h in enumerate(headers):
        header_cells.append(h + " " * max(0, widths[i] - visible_len(h)))
    header_line = "  ".join(header_cells)
    sep_line = "-" * len(header_line)

    row_lines = []
    for row in rows:
        cells = []
        for i, val in enumerate(row):
            if i >= num_cols:
                continue
            s = str(val)
            v_len = visible_len(s)
            w = widths[i]
            if v_len > w:
                s = s[:w-1] + "…" if w > 2 else s[:w]
                v_len = visible_len(s)
            cells.append(s + " " * max(0, w - v_len))
        row_lines.append("  ".join(cells))

    return header_line, sep_line, row_lines


def validate_app_name(name: str) -> str:
    """Validate app name to prevent shell injection or path traversal."""
    if not name:
        return ""
    if not re.match(r"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,31}$", name) or ".." in name or "/" in name or "\\" in name:
        print(f"{RED}ERROR: Invalid application name '{name}'. Must be 1-32 alphanumeric characters, dashes, or dots.{RESET}", file=sys.stderr)
        sys.exit(1)
    return name


def validate_cron_id(job_id: str) -> str:
    """Validate cron job ID to prevent shell injection or path traversal."""
    if not job_id or not re.match(r"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,47}$", job_id) or ".." in job_id:
        print(f"{RED}ERROR: Invalid cron job ID '{job_id}'. Must be 1-48 alphanumeric characters, dashes, underscores, or dots.{RESET}", file=sys.stderr)
        sys.exit(1)
    return job_id


def get_active_config_path():
    """Resolve active config.env path prioritizing inventory/ or .lamo/ over root."""
    if CONFIG_PATH is not None:
        return Path(CONFIG_PATH)
    for p in [BASE_DIR / "inventory" / "config.env", BASE_DIR / ".lamo" / "config.env", BASE_DIR / "config.env"]:
        if p.exists():
            return p
    return BASE_DIR / "inventory" / "config.env"


def get_active_nodes_path():
    """Resolve active nodes.json path prioritizing inventory/ or .lamo/ over root."""
    if NODES_CONFIG_PATH is not None:
        return Path(NODES_CONFIG_PATH)
    for p in [BASE_DIR / "inventory" / "nodes.json", BASE_DIR / ".lamo" / "nodes.json", BASE_DIR / "nodes.json"]:
        if p.exists():
            return p
    return BASE_DIR / "inventory" / "nodes.json"


def load_base_config(allow_empty=False):
    """Load baseline configuration variables from config.env or fallback to defaults."""
    cfg = {
        "SERVER_IP": "",
        "ADMIN_USER": "admin",
        "SSH_PORT": "2245",
        "BOOTSTRAP_USER": "root",
        "BOOTSTRAP_PORT": "22",
        "SERVER_HOSTNAME": "myserver",
        "SWAP_SIZE_GB": "2",
        "USER_AUDIT_RETENTION_DAYS": "7",
        "JOURNALD_MAX_USE_MB": "150",
        "DOCKER_LOG_MAX_SIZE": "10m",
        "DOCKER_LOG_MAX_FILES": "3",
    }

    config_file = get_active_config_path()
    nodes_file = get_active_nodes_path()

    nodes_exist = False
    if nodes_file.exists():
        try:
            with open(nodes_file, "r") as f:
                data = json.load(f)
                if data.get("nodes"):
                    nodes_exist = True
        except Exception:
            pass

    if not config_file.exists() and not nodes_exist and not allow_empty:
        print(f"{RED}ERROR: Neither config.env nor nodes.json found in {BASE_DIR}.{RESET}")
        print(f"Run: {CYAN}./lamo setup{RESET} to configure and bootstrap your first VPS.")
        sys.exit(1)

    if config_file.exists():
        with open(config_file, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip('"').strip("'")
                    cfg[k] = v

    if not cfg.get("SERVER_IP") and not nodes_exist and not allow_empty:
        print(f"{RED}ERROR: SERVER_IP is empty in config.env and no nodes configured in nodes.json{RESET}")
        print(f"Run: {CYAN}./lamo setup{RESET} to configure and bootstrap your first VPS.")
        sys.exit(1)

    return cfg


def get_nodes_registry(base_cfg):
    """Load or initialize multi-server cattle registry (nodes.json)."""
    nodes_file = get_active_nodes_path()
    if nodes_file.exists():
        try:
            with open(nodes_file, "r") as f:
                data = json.load(f)
                if "nodes" in data and data["nodes"]:
                    return data
        except Exception:
            pass

    if not base_cfg.get("SERVER_IP"):
        return {"default": None, "nodes": {}}

    # Initialize from config.env
    default_name = base_cfg.get("SERVER_HOSTNAME", "node-1")
    data = {
        "default": default_name,
        "nodes": {
            default_name: {
                "name": default_name,
                "host": base_cfg["SERVER_IP"],
                "port": int(base_cfg.get("SSH_PORT", 2245)),
                "user": base_cfg.get("ADMIN_USER", "admin"),
                "bootstrap_user": base_cfg.get("BOOTSTRAP_USER", "root"),
                "bootstrap_port": int(base_cfg.get("BOOTSTRAP_PORT", 22)),
                "hostname": default_name,
                "container_runtime": base_cfg.get("CONTAINER_RUNTIME", "docker"),
                "notes": "Primary cattle server",
            }
        }
    }
    nodes_file.parent.mkdir(parents=True, exist_ok=True)
    with open(nodes_file, "w") as f:
        json.dump(data, f, indent=2)
    return data


def save_nodes_registry(data):
    """Save multi-server registry."""
    nodes_file = get_active_nodes_path()
    nodes_file.parent.mkdir(parents=True, exist_ok=True)
    with open(nodes_file, "w") as f:
        json.dump(data, f, indent=2)


def resolve_active_node(base_cfg, target_node_name=None):
    """Resolve target cattle node configuration for execution."""
    reg = get_nodes_registry(base_cfg)
    node_name = target_node_name or reg.get("default")
    if not node_name or node_name not in reg.get("nodes", {}):
        available = ", ".join(reg.get("nodes", {}).keys())
        print(f"{RED}ERROR: Node '{node_name}' not found in nodes.json.{RESET}")
        print(f"Configured cattle nodes: {CYAN}{available}{RESET}")
        sys.exit(1)

    node_data = reg["nodes"][node_name]
    cfg = dict(base_cfg)
    cfg["NODE_NAME"] = node_name
    cfg["SERVER_IP"] = node_data["host"]
    cfg["SSH_PORT"] = str(node_data.get("port", 2245))
    cfg["ADMIN_USER"] = node_data.get("user", base_cfg.get("ADMIN_USER", "admin"))
    cfg["SERVER_HOSTNAME"] = node_data.get("hostname", node_name)
    if "bootstrap_user" in node_data:
        cfg["BOOTSTRAP_USER"] = node_data["bootstrap_user"]
    if "bootstrap_port" in node_data:
        cfg["BOOTSTRAP_PORT"] = str(node_data["bootstrap_port"])

    # Per-node logging & audit overrides (with fallback to base_cfg or defaults)
    if "audit_retention_days" in node_data:
        cfg["USER_AUDIT_RETENTION_DAYS"] = str(node_data["audit_retention_days"])
    elif "USER_AUDIT_RETENTION_DAYS" in node_data:
        cfg["USER_AUDIT_RETENTION_DAYS"] = str(node_data["USER_AUDIT_RETENTION_DAYS"])
    if "journald_max_use_mb" in node_data:
        cfg["JOURNALD_MAX_USE_MB"] = str(node_data["journald_max_use_mb"])
    elif "JOURNALD_MAX_USE_MB" in node_data:
        cfg["JOURNALD_MAX_USE_MB"] = str(node_data["JOURNALD_MAX_USE_MB"])
    if "docker_log_max_size" in node_data:
        cfg["DOCKER_LOG_MAX_SIZE"] = str(node_data["docker_log_max_size"])
    elif "DOCKER_LOG_MAX_SIZE" in node_data:
        cfg["DOCKER_LOG_MAX_SIZE"] = str(node_data["DOCKER_LOG_MAX_SIZE"])
    if "docker_log_max_files" in node_data:
        cfg["DOCKER_LOG_MAX_FILES"] = str(node_data["docker_log_max_files"])
    elif "DOCKER_LOG_MAX_FILES" in node_data:
        cfg["DOCKER_LOG_MAX_FILES"] = str(node_data["DOCKER_LOG_MAX_FILES"])

    runtime_val = node_data.get("container_runtime", node_data.get("runtime", base_cfg.get("CONTAINER_RUNTIME", "docker")))
    cfg["CONTAINER_RUNTIME"] = str(runtime_val).lower()

    return cfg, reg


def get_ssh_mux_opts(cfg):
    """Return SSH multiplexing arguments tailored per node socket."""
    node_socket = SSH_MUX_DIR / f"{cfg.get('NODE_NAME', 'default')}.sock"
    return [
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath={node_socket}",
        "-o", "ControlPersist=10m",
        "-o", "ConnectTimeout=4",
        "-o", "LogLevel=ERROR",
    ]


def run_ssh(cfg, remote_cmd, interactive=False, capture=False, check=True):
    """Execute command on remote cattle node over multiplexed SSH."""
    mux_opts = get_ssh_mux_opts(cfg)
    ssh_cmd = [
        "ssh",
        *mux_opts,
        "-p", str(cfg["SSH_PORT"]),
    ]
    if interactive:
        ssh_cmd.append("-t")

    ssh_cmd.append(f"{cfg['ADMIN_USER']}@{cfg['SERVER_IP']}")
    if remote_cmd:
        ssh_cmd.append(remote_cmd)

    if interactive:
        res = subprocess.run(ssh_cmd)
        return res.returncode

    res = subprocess.run(
        ssh_cmd,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )
    if capture:
        return res.stdout.strip() if res.stdout else ""
    return res.returncode


def cmd_ping(cfg):
    """Test SSH connectivity to the targeted cattle node."""
    print(f"==> Contacting cattle node {GOLD}{cfg.get('NODE_NAME', 'default')}{RESET} ({CYAN}{cfg['SERVER_IP']}:{cfg['SSH_PORT']}{RESET}) as {BOLD}{cfg['ADMIN_USER']}{RESET}...")
    try:
        out = run_ssh(cfg, "echo 'PONG'", capture=True)
        if "PONG" in out:
            print(f"{GREEN}✓ Connected successfully to node '{cfg.get('NODE_NAME')}' ({cfg['SERVER_IP']}:{cfg['SSH_PORT']}){RESET}")
            return 0
    except Exception:
        pass

    # Fallback bootstrap check
    print(f"Port {cfg['SSH_PORT']} not reachable. Checking bootstrap port {cfg['BOOTSTRAP_PORT']}...")
    try:
        res = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=4", "-p", str(cfg["BOOTSTRAP_PORT"]), f"{cfg['BOOTSTRAP_USER']}@{cfg['SERVER_IP']}", "echo 'PONG'"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        if "PONG" in res.stdout:
            print(f"{GOLD}⚡ Node is reachable on bootstrap port {cfg['BOOTSTRAP_PORT']}. Run 'lamo setup' to complete provisioning.{RESET}")
            return 0
    except Exception:
        pass

    print(f"{RED}✗ Node '{cfg.get('NODE_NAME')}' ({cfg['SERVER_IP']}) unreachable on ports {cfg['SSH_PORT']} and {cfg['BOOTSTRAP_PORT']}.{RESET}")
    return 1


def get_node_env(cfg):
    """Generate environment variables to pass active cattle node parameters to state.py."""
    env = os.environ.copy()
    env["SERVER_IP"] = cfg["SERVER_IP"]
    env["SSH_PORT"] = str(cfg["SSH_PORT"])
    env["ADMIN_USER"] = cfg["ADMIN_USER"]
    env["SERVER_HOSTNAME"] = cfg["SERVER_HOSTNAME"]
    env["BOOTSTRAP_USER"] = cfg.get("BOOTSTRAP_USER", "root")
    env["BOOTSTRAP_PORT"] = str(cfg.get("BOOTSTRAP_PORT", 22))
    env["NODE_NAME"] = cfg.get("NODE_NAME", "default")
    env["SWAP_SIZE_GB"] = str(cfg.get("SWAP_SIZE_GB", 2))
    env["USER_AUDIT_RETENTION_DAYS"] = str(cfg.get("USER_AUDIT_RETENTION_DAYS", "7"))
    env["JOURNALD_MAX_USE_MB"] = str(cfg.get("JOURNALD_MAX_USE_MB", "150"))
    env["DOCKER_LOG_MAX_SIZE"] = str(cfg.get("DOCKER_LOG_MAX_SIZE", "10m"))
    env["DOCKER_LOG_MAX_FILES"] = str(cfg.get("DOCKER_LOG_MAX_FILES", "3"))
    env["CONTAINER_RUNTIME"] = str(cfg.get("CONTAINER_RUNTIME", "docker")).lower()
    return env


def cmd_status(cfg):
    """Inspect node provisioning state."""
    state_script = BASE_DIR / "scripts" / "state.py"
    subprocess.run([sys.executable, str(state_script), "status"], cwd=BASE_DIR, env=get_node_env(cfg))


def ensure_local_ssh_key() -> Path:
    """Locate an existing local SSH public key or generate an ed25519 key pair automatically."""
    ssh_dir = Path.home() / ".ssh"
    ssh_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    for key_name in ("id_ed25519.pub", "id_ecdsa.pub", "id_rsa.pub"):
        candidate = ssh_dir / key_name
        if candidate.exists() and candidate.stat().st_size > 0:
            return candidate

    priv_key = ssh_dir / "id_ed25519"
    pub_key = ssh_dir / "id_ed25519.pub"
    print(f"==> No local SSH key found in ~/.ssh. Generating new Ed25519 SSH key ({priv_key})...")
    subprocess.run(
        ["ssh-keygen", "-t", "ed25519", "-N", "", "-f", str(priv_key)],
        check=True,
    )
    return pub_key


def ensure_ssh_login_and_key(cfg) -> bool:
    """
    Verify passwordless SSH key access to the VPS before running the automated pipeline.
    1. Checks hardened port (ADMIN_USER@SERVER_IP:SSH_PORT) first.
    2. Checks bootstrap port (BOOTSTRAP_USER@SERVER_IP:BOOTSTRAP_PORT) with BatchMode=yes.
    3. If bootstrap port requires a password (fresh VPS), installs the local SSH public key
       into BOOTSTRAP_USER's ~/.ssh/authorized_keys in a single interactive prompt so that
       all subsequent provisioning steps execute 100% unattended.
    """
    host = cfg["SERVER_IP"]
    admin_user = cfg["ADMIN_USER"]
    ssh_port = str(cfg["SSH_PORT"])
    boot_user = cfg.get("BOOTSTRAP_USER", "root")
    boot_port = str(cfg.get("BOOTSTRAP_PORT", 22))
    mux_opts = get_ssh_mux_opts(cfg)

    print(f"==> Verifying SSH login to {GOLD}{cfg.get('NODE_NAME', host)}{RESET} ({CYAN}{host}{RESET})...")

    # 1. Check if already hardened and reachable on SSH_PORT with SSH key
    hardened_check = subprocess.run(
        [
            "ssh", *mux_opts,
            "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=accept-new",
            "-p", ssh_port,
            f"{admin_user}@{host}",
            "echo PONG",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if hardened_check.returncode == 0 and "PONG" in hardened_check.stdout:
        print(f"{GREEN}✓ Hardened SSH login verified ({admin_user}@{host}:{ssh_port}).{RESET}")
        return True

    # 2. Check if bootstrap port already accepts our SSH key without password
    boot_check = subprocess.run(
        [
            "ssh",
            "-o", "ConnectTimeout=5",
            "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=accept-new",
            "-p", boot_port,
            f"{boot_user}@{host}",
            "echo PONG",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if boot_check.returncode == 0 and "PONG" in boot_check.stdout:
        print(f"{GREEN}✓ Bootstrap SSH key login verified ({boot_user}@{host}:{boot_port}).{RESET}")
        return True

    # 3. Fresh VPS: copy local SSH public key to bootstrap user (prompts for root password once)
    pub_key_path = ensure_local_ssh_key()
    pub_key_content = pub_key_path.read_text().strip()
    print(
        f"\n{GOLD}⚡ Initial VPS Login Setup:{RESET} Installing your SSH key ({CYAN}{pub_key_path.name}{RESET}) "
        f"into {BOLD}{boot_user}@{host}:{boot_port}{RESET}."
    )
    print(f"{DIM}   If prompted, enter the initial '{boot_user}' password from your VPS provider once.{RESET}\n")

    remote_install_key_cmd = (
        "umask 077 && mkdir -p ~/.ssh && "
        f"grep -qxF {shlex.quote(pub_key_content)} ~/.ssh/authorized_keys 2>/dev/null || "
        f"printf '%s\\n' {shlex.quote(pub_key_content)} >> ~/.ssh/authorized_keys && "
        "chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys && echo KEY_INSTALLED"
    )
    install_res = subprocess.run(
        [
            "ssh",
            "-o", "ConnectTimeout=10",
            "-o", "StrictHostKeyChecking=accept-new",
            "-p", boot_port,
            f"{boot_user}@{host}",
            remote_install_key_cmd,
        ]
    )
    if install_res.returncode != 0:
        print(f"{RED}✗ Failed to authenticate or install SSH key on {boot_user}@{host}:{boot_port}.{RESET}")
        return False

    # Verify passwordless login now works
    verify_res = subprocess.run(
        [
            "ssh",
            "-o", "ConnectTimeout=5",
            "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=accept-new",
            "-p", boot_port,
            f"{boot_user}@{host}",
            "echo PONG",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if verify_res.returncode == 0 and "PONG" in verify_res.stdout:
        print(f"{GREEN}✓ SSH public key installed! Passwordless login to {boot_user}@{host}:{boot_port} is ready.{RESET}\n")
        return True

    print(f"{RED}✗ SSH key was uploaded, but passwordless login verification failed on {boot_user}@{host}:{boot_port}.{RESET}")
    return False


def bootstrap_vps_wizard(base_cfg, args=None):
    """
    Interactive (or flag-driven) wizard to configure the first VPS (or a new VPS),
    persisting inventory/config.env and inventory/nodes.json before automated setup.
    """
    nodes_file = get_active_nodes_path()
    reg = {"default": None, "nodes": {}}
    if nodes_file.exists():
        try:
            with open(nodes_file, "r") as f:
                loaded = json.load(f)
                if isinstance(loaded, dict) and "nodes" in loaded:
                    reg = loaded
        except Exception:
            pass

    arg_name = getattr(args, "target_name", None) or getattr(args, "target_node", None) if args else None
    arg_host = getattr(args, "host", None) if args else None

    # Allow './lamo setup 203.0.113.10' where positional target_name is actually an IP
    if arg_name and not arg_host and re.match(r"^\d{1,3}(\.\d{1,3}){3}$", arg_name):
        arg_host = arg_name
        arg_name = None

    default_local_user = os.environ.get("USER", "admin")
    if default_local_user == "root":
        default_local_user = "admin"

    print(f"\n{BOLD}{'=' * 68}{RESET}")
    print(f" {GOLD}LAMO :: FIRST VPS ONBOARDING & AUTOMATED SETUP{RESET}")
    print(f"{BOLD}{'=' * 68}{RESET}")
    print(" Configure your VPS connection details once; Lamo will install your")
    print(" SSH key and execute all 11 hardening & gateway steps automatically.\n")

    host = arg_host or base_cfg.get("SERVER_IP", "")
    if not arg_host:
        prompt_ip = f" [{host}]" if host else ""
        entered_ip = input(f"  1. VPS IP address or domain{prompt_ip}: ").strip()
        if entered_ip:
            host = entered_ip
    if not host:
        print(f"{RED}ERROR: VPS IP address cannot be empty.{RESET}")
        sys.exit(1)

    default_name = arg_name or base_cfg.get("SERVER_HOSTNAME")
    if not default_name or default_name == "myserver":
        default_name = "node-1" if not reg.get("nodes") else f"node-{len(reg['nodes']) + 1}"
    if not arg_name:
        entered_name = input(f"  2. Node name / hostname [{default_name}]: ").strip()
        name = entered_name or default_name
    else:
        name = arg_name

    arg_user = getattr(args, "user", None) if args else None
    default_user = arg_user or base_cfg.get("ADMIN_USER") or default_local_user
    if not arg_user:
        entered_user = input(f"  3. Admin username to create [{default_user}]: ").strip()
        user = entered_user or default_user
    else:
        user = arg_user

    arg_port = getattr(args, "port", None) if args else None
    default_port = int(arg_port or base_cfg.get("SSH_PORT", 2245))
    if not arg_port:
        entered_port = input(f"  4. Hardened SSH port [{default_port}]: ").strip()
        port = int(entered_port) if entered_port.isdigit() else default_port
    else:
        port = int(arg_port)

    arg_boot_user = getattr(args, "bootstrap_user", None) if args else None
    default_boot_user = arg_boot_user or base_cfg.get("BOOTSTRAP_USER", "root")
    if not arg_boot_user:
        entered_boot_user = input(f"  5. Initial provider SSH user [{default_boot_user}]: ").strip()
        boot_user = entered_boot_user or default_boot_user
    else:
        boot_user = arg_boot_user

    arg_boot_port = getattr(args, "bootstrap_port", None) if args else None
    default_boot_port = int(arg_boot_port or base_cfg.get("BOOTSTRAP_PORT", 22))
    if not arg_boot_port:
        entered_boot_port = input(f"  6. Initial provider SSH port [{default_boot_port}]: ").strip()
        boot_port = int(entered_boot_port) if entered_boot_port.isdigit() else default_boot_port
    else:
        boot_port = int(arg_boot_port)

    arg_runtime = getattr(args, "runtime", None) if args else None
    default_runtime = (arg_runtime or base_cfg.get("CONTAINER_RUNTIME", "docker")).lower()
    if not arg_runtime:
        entered_rt = input(f"  7. Container engine [docker/podman] ({default_runtime}): ").strip().lower()
        runtime = entered_rt if entered_rt in ("docker", "podman") else default_runtime
    else:
        runtime = default_runtime

    reg.setdefault("nodes", {})[name] = {
        "name": name,
        "host": host,
        "port": int(port),
        "user": user,
        "bootstrap_user": boot_user,
        "bootstrap_port": int(boot_port),
        "hostname": name,
        "container_runtime": runtime,
        "notes": "Primary cattle server" if len(reg["nodes"]) == 0 else "Cattle Node",
    }
    reg["default"] = name
    save_nodes_registry(reg)

    # Also persist inventory/config.env if no config.env exists yet
    config_file = get_active_config_path()
    if not config_file.exists():
        config_file.parent.mkdir(parents=True, exist_ok=True)
        config_file.write_text(
            f'SERVER_IP="{host}"\n'
            f'BOOTSTRAP_USER="{boot_user}"\n'
            f'BOOTSTRAP_PORT="{boot_port}"\n'
            f'ADMIN_USER="{user}"\n'
            f'SSH_PORT="{port}"\n'
            f'SERVER_HOSTNAME="{name}"\n'
            f'SWAP_SIZE_GB="{base_cfg.get("SWAP_SIZE_GB", "2")}"\n'
            f'CONTAINER_RUNTIME="{runtime}"\n'
        )

    try:
        rel_nodes = nodes_file.relative_to(BASE_DIR)
    except ValueError:
        rel_nodes = nodes_file
    print(f"\n{GREEN}✓ Saved node '{name}' ({host}:{port}) as active default in {rel_nodes}.{RESET}\n")
    base_cfg["SERVER_IP"] = host
    base_cfg["ADMIN_USER"] = user
    base_cfg["SSH_PORT"] = str(port)
    base_cfg["BOOTSTRAP_USER"] = boot_user
    base_cfg["BOOTSTRAP_PORT"] = str(boot_port)
    base_cfg["SERVER_HOSTNAME"] = name
    base_cfg["CONTAINER_RUNTIME"] = runtime
    cfg, _ = resolve_active_node(base_cfg, name)
    return cfg


def cmd_setup(cfg, force=False, skip_login_check=False):
    """Verify/bootstrap SSH login and execute all pending or changed provisioning steps automatically."""
    if not skip_login_check:
        if not ensure_ssh_login_and_key(cfg):
            sys.exit(1)
    state_script = BASE_DIR / "scripts" / "state.py"
    cmd = [sys.executable, str(state_script), "apply"]
    if force:
        cmd.append("--force")
    res = subprocess.run(cmd, cwd=BASE_DIR, env=get_node_env(cfg))
    if res.returncode == 0:
        print(f"\n{GREEN}✨ Node '{cfg.get('NODE_NAME')}' ({cfg['SERVER_IP']}:{cfg['SSH_PORT']}) is fully provisioned and ready!{RESET}")
        print(f"   • Open SSH session:     {CYAN}./lamo node ssh{RESET}")
        print(f"   • Configure Telegram:   {CYAN}./lamo telegram{RESET}")
        print(f"   • Deploy an app:        {CYAN}./lamo app add{RESET}\n")
