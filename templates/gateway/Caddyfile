# Global Options
{
	# Production Server Settings: HTTP/1.1, HTTP/2, and HTTP/3 (QUIC)
	servers {
		protocols h1 h2 h3
		strict_sni_host
	}

	# Structured JSON logging
	log {
		output stdout
		format json
	}
}

# Snippet: Production TLS Hardening
# Enforces TLS 1.2+ minimum, secure forward-secret AEAD ciphers, and modern curves
(tls-security) {
	tls {
		protocols tls1.2 tls1.3
		curves x25519 secp256r1
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
	}
}

# Snippet: Production-Grade Security Headers & Footprint Removal
(security-headers) {
	header {
		# Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# Clickjacking mitigation
		X-Frame-Options "SAMEORIGIN"

		# Referrer privacy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Hardware and API restrictions
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# Legacy XSS protection filter
		X-XSS-Protection "1; mode=block"

		# Strip all server signatures and technology footprints
		-Server
		-X-Powered-By
		-X-AspNet-Version
		-X-AspNetMvc-Version
		-Via
	}
}

# Import all individual application routes managed by Lamo CLI
import /etc/caddy/conf.d/*.caddy

